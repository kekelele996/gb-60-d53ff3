# ============================================
# 花卉电商平台环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
# ============================================

# --------------------------------------------
# PostgreSQL 数据库配置
# --------------------------------------------
POSTGRES_DB=flower_shop
POSTGRES_USER=flower
POSTGRES_PASSWORD=flower123

# 对外暴露端口 (Docker Compose)
POSTGRES_PORT=5601

# --------------------------------------------
# Redis 缓存配置
# --------------------------------------------
REDIS_PORT=6501

# --------------------------------------------
# MinIO 对象存储配置
# --------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --------------------------------------------
# JWT 认证配置
# 生产环境请使用复杂的随机字符串
# --------------------------------------------
JWT_SECRET=your-jwt-secret-key-change-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# 服务端口映射
# --------------------------------------------
# 前端访问端口
FRONTEND_PORT=8101
# 后端 API 端口
BACKEND_PORT=3101

# --------------------------------------------
# 支付宝沙箱配置（可选，当前使用模拟支付）
# --------------------------------------------
# ALIPAY_APP_ID=your-app-id
# ALIPAY_PRIVATE_KEY=your-private-key
# ALIPAY_PUBLIC_KEY=alipay-public-key
# ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
